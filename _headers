/*
  Content-Security-Policy: default-src 'self' https:; connect-src 'self' https://www.youtube.com https://i.ytimg.com https://api.allorigins.win https://static.cloudflareinsights.com https://*.cloudflareinsights.com https://cloudflareinsights.com https://*.cloudflare.com; img-src 'self' data: https://yt3.ggpht.com https://i.ytimg.com; script-src 'self' 'unsafe-inline' https://www.youtube.com https://static.cloudflareinsights.com https://*.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-src https://www.youtube.com https://youtube.com;
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=()
*/

/https://yt3.ggpht.com/*
  Cache-Control: public, max-age=86400, s-maxage=86400, immutable

/https://i.ytimg.com/*
  Cache-Control: public, max-age=86400, s-maxage=86400, immutable

/https://static.cloudflareinsights.com/*
  Cache-Control: public, max-age=86400, s-maxage=86400

/pages/*
  Status: 301
  Location: /:splat

/channel.json
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400

/videos.json
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400
